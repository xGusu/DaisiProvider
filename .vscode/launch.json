{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DaisiProvider Upload GUI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-upload-desktop",
      "program": "${workspaceFolder}\\src\\DaisiProvider.Desktop\\bin\\Debug\\net10.0-windows\\DaisiProvider.Desktop.dll",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    },
    {
      "name": "Upload one ZIP (command line)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-upload-worker",
      "program": "${workspaceFolder}\\src\\DaisiProvider.Worker\\bin\\Debug\\net10.0\\DaisiProvider.Worker.dll",
      "args": [
        "process",
        "${input:zipPath}",
        "${input:destinationRoot}",
        "${input:computerName}",
        "${input:projectName}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "zipPath",
      "type": "promptString",
      "description": "Path to ZIP containing order_report.json and files matching the copy rules"
    },
    {
      "id": "destinationRoot",
      "type": "promptString",
      "description": "Local or network destination root"
    },
    {
      "id": "computerName",
      "type": "promptString",
      "description": "Computer folder name",
      "default": "${env:COMPUTERNAME}"
    },
    {
      "id": "projectName",
      "type": "promptString",
      "description": "Project folder name"
    }
  ]
}
