<Window x:Class="DaisiProvider.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DaisiProvider - Upload"
        Width="860"
        Height="760"
        MinWidth="700"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Upload" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="#606060"
                       Text="Copy pictures from one order ZIP or process a dated archive folder." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Source ZIP" Padding="12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ZipPathTextBox"
                                 Grid.Column="0"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 ToolTip="ZIP containing order_report.json and raw PNG pictures" />
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Width="100"
                                Height="32"
                                Margin="10,0,0,0"
                                Click="BrowseZip_Click" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Archive folder (year\month\day)" Padding="12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ArchiveFolderTextBox"
                                 Grid.Column="0"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Folder containing dated folders with order ZIP archives" />
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Width="100"
                                Height="32"
                                Margin="10,0,0,0"
                                Click="BrowseArchiveFolder_Click" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Order details" Padding="12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Source folder date" Margin="0,0,0,5" />
                            <DatePicker x:Name="SourceDatePicker" Height="32" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Order ID" Margin="0,0,0,5" />
                            <TextBox x:Name="OrderIdTextBox"
                                     Height="32"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Order timestamp (yyyyMMddHHmmss)"
                                       Margin="0,0,0,5" />
                            <TextBox x:Name="OrderTimestampTextBox"
                                     Height="32"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Destination" Padding="12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                    Margin="0,0,10,12">
                            <TextBlock Text="Destination root" Margin="0,0,0,5" />
                            <TextBox x:Name="DestinationRootTextBox"
                                     Height="32"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="2"
                                Content="Browse..."
                                Width="100"
                                Height="32"
                                Margin="0,20,0,0"
                                Click="BrowseDestination_Click" />
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Computer folder" Margin="0,0,0,5" />
                            <TextBox x:Name="ComputerNameTextBox"
                                     Height="32"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                            <TextBlock Text="Project folder" Margin="0,0,0,5" />
                            <TextBox x:Name="ProjectNameTextBox"
                                     Height="32"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Destination preview" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Pictures" FontWeight="SemiBold" />
                        <TextBlock x:Name="PicturePathPreview"
                                   Margin="0,3,0,10"
                                   TextWrapping="Wrap"
                                   Foreground="#505050" />
                        <TextBlock Text="Order JSON" FontWeight="SemiBold" />
                        <TextBlock x:Name="ReportPathPreview"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#505050" />
                    </StackPanel>
                </GroupBox>

                <Border Padding="12"
                        Background="#FFF4E5"
                        CornerRadius="4"
                        Margin="0,0,0,14">
                    <TextBlock TextWrapping="Wrap"
                               Text="Preview milestone copies pictures only. JSON report output awaits confirmation of target schema and field mapping." />
                </Border>

                <CheckBox x:Name="OverwriteOnRetryCheckBox"
                          Content="Restart from first picture and overwrite existing files"
                          Margin="0,0,0,12" />
                <ProgressBar x:Name="CopyProgressBar"
                             Height="18"
                             Minimum="0"
                             Maximum="1"
                             Margin="0,0,0,8" />
                <TextBlock x:Name="StatusTextBlock"
                           Text="Ready"
                           Foreground="#505050"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock DockPanel.Dock="Left"
                       x:Name="ProgressCountTextBlock"
                       VerticalAlignment="Center"
                       Foreground="#505050"
                       Text="0 / 0 pictures" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="100"
                        Height="36"
                        Margin="0,0,10,0"
                        IsEnabled="False"
                        Click="Cancel_Click" />
                <Button x:Name="ProcessFolderButton"
                        Content="Process folder"
                        Width="140"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="ProcessFolder_Click" />
                <Button x:Name="ProcessButton"
                        Content="Copy this ZIP"
                        Width="140"
                        Height="36"
                        IsDefault="True"
                        Click="Process_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
