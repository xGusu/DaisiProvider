<Window x:Class="DaisiProvider.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DaisiProvider"
        Width="960"
        Height="640"
        MinWidth="780"
        MinHeight="500"
        FontFamily="Segoe UI"
        FontSize="12.5"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource PageBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="Help_Executed" />
    </Window.CommandBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left menu -->
        <DockPanel Grid.Column="0" Background="{StaticResource NavBrush}">
            <TextBlock DockPanel.Dock="Top"
                       Text="DaisiProvider"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="14,14,14,12" />
            <TextBlock x:Name="VersionTextBlock"
                       DockPanel.Dock="Bottom"
                       Foreground="{StaticResource NavTextBrush}"
                       FontSize="11"
                       Margin="14,4,14,10" />
            <Button DockPanel.Dock="Bottom"
                    Content="Help   F1"
                    Margin="14,4"
                    Background="Transparent"
                    Foreground="{StaticResource NavTextBrush}"
                    BorderBrush="{StaticResource NavHoverBrush}"
                    Command="Help" />
            <ListBox x:Name="NavList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="NavList_SelectionChanged">
                <ListBoxItem Content="Monitor" />
                <ListBoxItem Content="Manual upload" />
                <ListBoxItem Content="Destination" />
                <ListBoxItem Content="Copy rules" />
                <ListBoxItem Content="JSON rules" />
            </ListBox>
        </DockPanel>

        <!-- Pages and bottom bar -->
        <Grid Grid.Column="1" Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Monitor -->
            <Grid x:Name="MonitorPage" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Monitor" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Watches the local archive folder (year\month\day) and delivers each new ZIP. Runs while this app is open." />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="MonitorSettingsPanel" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Monitored folder" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WatchFolderTextBox" />
                                <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="BrowseWatchFolder_Click" />
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Width="170" Margin="0,0,10,0">
                                    <TextBlock Text="Process ZIPs from" Style="{StaticResource FieldLabel}" />
                                    <DatePicker x:Name="ProcessFromDatePicker"
                                                ToolTip="ZIPs in day folders before this date are never touched" />
                                </StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,0">
                                    <TextBlock Text="Look back days" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="LookBackDaysTextBox"
                                             ToolTip="Day folders older than this many days are not read" />
                                </StackPanel>
                                <StackPanel Width="90">
                                    <TextBlock Text="Scan every (s)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ScanIntervalTextBox" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Width="170" VerticalAlignment="Center">
                            <TextBlock x:Name="MonitorStateTextBlock"
                                       Text="Stopped"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,2" />
                            <TextBlock x:Name="MonitorLastScanTextBlock"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11.5"
                                       Margin="0,0,0,6" />
                            <Button x:Name="MonitorStartStopButton"
                                    Content="Start"
                                    Height="30"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="MonitorStartStop_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid x:Name="MonitorGrid"
                          Grid.Row="2"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="85" />
                        <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="170" />
                        <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="60" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="140" />
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="3" Margin="0,8,0,0">
                    <Button x:Name="MonitorRetryButton"
                            DockPanel.Dock="Right"
                            Content="Retry selected"
                            ToolTip="Retry a failed ZIP now"
                            Click="MonitorRetry_Click" />
                    <TextBlock x:Name="MonitorSummaryTextBlock"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Grid>

            <!-- Manual upload -->
            <ScrollViewer x:Name="ManualPage" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Manual upload" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Deliver one ZIP or a whole archive folder by hand. Not available while the monitor runs." />

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="One order ZIP" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ZipPathTextBox" Grid.Row="1" />
                            <Button Grid.Row="1" Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="BrowseZip_Click" />
                            <Button x:Name="ProcessButton"
                                    Grid.Row="1" Grid.Column="2"
                                    Content="Copy this ZIP"
                                    Width="120"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="Process_Click" />
                            <TextBlock Grid.Row="2" Text="Archive folder (all ZIPs below it)" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                            <TextBox x:Name="ArchiveFolderTextBox" Grid.Row="3" />
                            <Button Grid.Row="3" Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="BrowseArchiveFolder_Click" />
                            <Button x:Name="ProcessFolderButton"
                                    Grid.Row="3" Grid.Column="2"
                                    Content="Process folder"
                                    Width="120"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ProcessFolder_Click" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox x:Name="OverwriteOnRetryCheckBox"
                                      Content="Overwrite: copy again from the first file and rewrite the log JSON, even if already delivered"
                                      Margin="0,0,0,8" />
                            <ProgressBar x:Name="CopyProgressBar" Height="10" Minimum="0" Maximum="1" Margin="0,0,0,6" />
                            <DockPanel>
                                <Button x:Name="CancelButton"
                                        DockPanel.Dock="Right"
                                        Content="Cancel"
                                        IsEnabled="False"
                                        Click="Cancel_Click" />
                                <TextBlock x:Name="ProgressCountTextBlock"
                                           Text="0 / 0 files"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="StatusTextBlock"
                                       Text="Ready"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Destination -->
            <ScrollViewer x:Name="DestinationPage" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Destination" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Where files and the log JSON go. No drive letter is needed for a network share." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="LocalDestinationRadioButton"
                                             Content="Local PC path"
                                             GroupName="DestinationKind"
                                             IsChecked="True"
                                             Margin="0,0,20,0"
                                             Checked="DestinationKind_Changed" />
                                <RadioButton x:Name="NetworkDestinationRadioButton"
                                             Content="Network share"
                                             GroupName="DestinationKind"
                                             Checked="DestinationKind_Changed" />
                            </StackPanel>

                            <Grid x:Name="LocalDestinationPanel" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Destination root ({root})" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DestinationRootTextBox" Grid.Row="1" />
                                <Button Grid.Row="1" Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="BrowseDestination_Click" />
                            </Grid>

                            <Grid x:Name="NetworkDestinationPanel" Margin="0,0,0,8" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,6">
                                    <TextBlock Text="Network path ({root}), e.g. \\server\share" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="NetworkPathTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,6,0">
                                    <TextBlock Text="User (empty = current account)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="NetworkUserTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Password (saved encrypted)" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox x:Name="NetworkPasswordBox" />
                                </StackPanel>
                                <Button x:Name="TestConnectionButton"
                                        Grid.Row="1" Grid.Column="2"
                                        Content="Test connection"
                                        VerticalAlignment="Bottom"
                                        Click="TestConnection_Click" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Computer ({computer})" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ComputerNameTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Project ({project}, only if used)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ProjectNameTextBox" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Reset to default" Height="22" Click="ResetTemplates_Click" />
                                <TextBlock Text="Path layout" Style="{StaticResource CardTitle}" />
                            </DockPanel>
                            <TextBlock Text="Files folder" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="FilesTemplateTextBox" GotFocus="TemplateTextBox_GotFocus" Margin="0,0,0,6" />
                            <TextBlock Text="Log JSON file (must end with .json)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="LogTemplateTextBox" GotFocus="TemplateTextBox_GotFocus" Margin="0,0,0,6" />
                            <WrapPanel x:Name="TokenButtonsPanel" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Preview (example order)" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Files" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="PicturePathPreview" Style="{StaticResource PreviewText}" />
                            <TextBlock Text="Log JSON" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="ReportPathPreview" Style="{StaticResource PreviewText}" />
                            <TextBlock Text="ImagePath in log JSON" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="ImagePathPreview" Style="{StaticResource PreviewText}" Margin="0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Copy rules -->
            <Grid x:Name="CopyRulesPage" Grid.Row="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Copy rules" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="A folder inside the ZIP and the file types to copy from it, e.g. bmp, png. * = all files. Empty folder = ZIP root. Subfolders are not included." />
                </StackPanel>
                <DataGrid x:Name="CopyRulesGrid" Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Enabled"
                                                Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                Width="70" />
                        <DataGridTextColumn Header="ZIP folder" Binding="{Binding ZipFolder}" Width="200" />
                        <DataGridTextColumn Header="File types" Binding="{Binding FileTypes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add rule" Margin="0,0,6,0" Click="AddCopyRule_Click" />
                    <Button Content="Remove rule" Click="RemoveCopyRule_Click" />
                </StackPanel>
            </Grid>

            <!-- JSON rules -->
            <ScrollViewer x:Name="JsonRulesPage" Grid.Row="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="JSON rules" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Values for the DAISI log JSON that are not in the ZIP. * = mandatory. Press F1 for every field." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Machine" Style="{StaticResource CardTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Plant * (3 letters)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PlantTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="Cam" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CamTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                    <TextBlock Text="Chamber" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ChamberTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Equipment (Betriebsmittel-Nr)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="EquipmentTextBox" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       Text="ComputerID = Computer on the Destination page." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Prediction" Style="{StaticResource CardTitle}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="DAISI project * (as in DAISI Models)" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DaisiProjectTextBox"
                                             ToolTip="Must match the project path in the DAISI Models section. Tokens are filled per picture." />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Prediction type *" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="PredictionTypeComboBox" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel>
                                <Button Content="{}{position}"
                                        Style="{StaticResource TokenButton}"
                                        ToolTip="Position number before # in the picture name, e.g. 101"
                                        Click="InsertProjectToken_Click" />
                                <Button Content="{}{computer}"
                                        Style="{StaticResource TokenButton}"
                                        ToolTip="Computer from the Destination page"
                                        Click="InsertProjectToken_Click" />
                                <Button Content="{}{project}"
                                        Style="{StaticResource TokenButton}"
                                        ToolTip="Project from the Destination page"
                                        Click="InsertProjectToken_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="ProjectPreviewTextBlock" Style="{StaticResource PreviewText}" />

                            <TextBlock Text="AI models root (optional): one folder per position, e.g. 101\meta.json" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ModelsRootTextBox"
                                         ToolTip="Picture 124#... uses folder 124. Gives ModelID; for real AI runs also PredictionType, Threshold and Blobsize." />
                                <Button Grid.Column="1" Content="Browse..." Margin="6,0,0,0" Click="BrowseModelsRoot_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="{StaticResource NoteBrush}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="The log JSON is the server's signal to move the order to the cloud. It is written only after all files are copied, and never when copying fails." />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom bar -->
            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right"
                        Content="Save settings"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Save everything on all pages"
                        Click="SaveSettings_Click" />
                <TextBlock x:Name="GlobalStatusTextBlock"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
