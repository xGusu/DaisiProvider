<Project>
  <!-- Includes .NET: copy the folder to any 64-bit Windows PC and start DaisiProvider.Desktop.exe. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\DaisiProvider-$(Version)-selfcontained\</PublishDir>
  </PropertyGroup>
</Project>
