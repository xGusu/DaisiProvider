<Project>
  <!-- Small folder; the target PC needs the .NET 10 Desktop Runtime (x64) installed. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\DaisiProvider-$(Version)-runtime\</PublishDir>
  </PropertyGroup>
</Project>
