<Window x:Class="DaisiProvider.Desktop.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DaisiProvider Help"
        Icon="/daisiprovider.ico"
        Width="900"
        Height="640"
        MinWidth="640"
        MinHeight="420"
        FontFamily="Segoe UI"
        FontSize="12.5"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource CardBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="TopicList"
                 Background="{StaticResource NavBrush}"
                 BorderThickness="0"
                 Padding="0,10,0,0"
                 DisplayMemberPath="Title"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource NavItem}"
                 SelectionChanged="TopicList_SelectionChanged" />
        <FlowDocumentScrollViewer x:Name="TopicViewer"
                                  Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsToolBarVisible="False" />
    </Grid>
</Window>
